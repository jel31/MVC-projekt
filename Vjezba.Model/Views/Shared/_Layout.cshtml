<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Šapice u pokretu</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/forms.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
        var isIndex = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase);
        var isOwners = string.Equals(currentController, "Owners", StringComparison.OrdinalIgnoreCase);
        var isWalkers = string.Equals(currentController, "Walkers", StringComparison.OrdinalIgnoreCase);
        var isBookings = string.Equals(currentController, "Bookings", StringComparison.OrdinalIgnoreCase);
        var isDogs = string.Equals(currentController, "Dogs", StringComparison.OrdinalIgnoreCase);
        var isPayments = string.Equals(currentController, "Payments", StringComparison.OrdinalIgnoreCase);
        var isReviews = string.Equals(currentController, "Reviews", StringComparison.OrdinalIgnoreCase);
        var toastMessage = TempData["ToastMessage"] as string;
        var toastType = (TempData["ToastType"] as string) ?? "success";
    }

    <header class="app-header">
        <div class="app-header__inner">
            <a class="brand" href="@Url.Action("Index", "Home")">
                <span class="brand__text">Šapice u pokretu</span>
            </a>

            <nav class="app-nav" aria-label="Glavna navigacija">
                <a class="nav-pill @(isIndex ? "is-active" : string.Empty)" aria-current="@(isIndex ? "page" : null)" href="@Url.Action("Index", "Home")">Početna</a>
                <a class="nav-pill @(isOwners ? "is-active" : string.Empty)" aria-current="@(isOwners ? "page" : null)" href="@Url.Action("Index", "Owners")">Vlasnici</a>
                <a class="nav-pill @(isWalkers ? "is-active" : string.Empty)" aria-current="@(isWalkers ? "page" : null)" href="@Url.Action("Index", "Walkers")">Šetači</a>
                <a class="nav-pill @(isBookings ? "is-active" : string.Empty)" aria-current="@(isBookings ? "page" : null)" href="@Url.Action("Index", "Bookings")">Rezervacije</a>
                <a class="nav-pill @(isDogs ? "is-active" : string.Empty)" aria-current="@(isDogs ? "page" : null)" href="@Url.Action("Index", "Dogs")">Psi</a>
                <a class="nav-pill @(isPayments ? "is-active" : string.Empty)" aria-current="@(isPayments ? "page" : null)" href="@Url.Action("Index", "Payments")">Uplate</a>
                <a class="nav-pill @(isReviews ? "is-active" : string.Empty)" aria-current="@(isReviews ? "page" : null)" href="@Url.Action("Index", "Reviews")">Recenzije</a>
            </nav>
        </div>
    </header>

    <main class="app-main">
        @RenderBody()
    </main>

    @if (!string.IsNullOrWhiteSpace(toastMessage))
    {
        <section class="app-toast-stack" aria-live="polite" aria-atomic="true">
            <article class="app-toast app-toast--@toastType" role="status" data-toast>
                <p class="app-toast__message">@toastMessage</p>
                <button type="button" class="app-toast__close" aria-label="Zatvori obavijest" data-toast-close>×</button>
            </article>
        </section>
    }

    <footer class="app-footer">
        <p>Šapice u pokretu</p>
    </footer>

    <script src="~/js/controls.js" asp-append-version="true"></script>
    <script src="~/js/toast.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
