@model Vjezba.Model.Dog

<div asp-validation-summary="ModelOnly" class="validation-message"></div>

<div class="form-grid">
    <div class="form-field">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="validation-message"></span>
    </div>

    <div class="form-field">
        <label asp-for="Breed"></label>
        <input asp-for="Breed" class="form-control" />
        <span asp-validation-for="Breed" class="validation-message"></span>
    </div>

    <div class="form-field">
        <label asp-for="Age"></label>
        <input asp-for="Age" type="number" class="form-control" />
        <span asp-validation-for="Age" class="validation-message"></span>
    </div>

    <div class="form-field">
        <label asp-for="OwnerId">Vlasnik</label>
        <select asp-for="OwnerId" class="form-control" asp-items="ViewBag.OwnerSelectList"></select>
        <span asp-validation-for="OwnerId" class="validation-message"></span>
    </div>

    <div class="form-field">
        <label asp-for="IsVaccinated"></label>
        <input asp-for="IsVaccinated" type="checkbox" />
        <span asp-validation-for="IsVaccinated" class="validation-message"></span>
    </div>

    <div class="form-field">
        <label asp-for="IsFriendly"></label>
        <input asp-for="IsFriendly" type="checkbox" />
        <span asp-validation-for="IsFriendly" class="validation-message"></span>
    </div>
</div>

@await Html.PartialAsync("_ValidationScriptsPartial")
