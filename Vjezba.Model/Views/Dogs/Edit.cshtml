@model Vjezba.Model.Dog

@{
    ViewData["Title"] = "Uredi psa";
}

<section class="page-header" aria-labelledby="edit-dog">
    <div>
        <span class="eyebrow">Uredi</span>
        <h1 id="edit-dog">Uredi psa</h1>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline" href="@Url.Action("Index", "Dogs")">Natrag na popis</a>
    </div>
</section>

<form method="post" asp-action="Edit" asp-route-id="@Model.Id">
    @await Html.PartialAsync("_DogForm", Model)

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Spremi</button>
        <a class="btn btn-outline" href="@Url.Action("Index", "Dogs")">Otkaži</a>
    </div>
</form>
