@model Vjezba.Model.Payment

@{
    ViewData["Title"] = "Uredi uplatu";
}

<form method="post" asp-action="Edit" asp-route-id="@Model.Id">
    @await Html.PartialAsync("_PaymentForm", Model)

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Spremi</button>
        <a class="btn btn-outline" href="@Url.Action("Index", "Payments")">Otkaži</a>
    </div>
</form>
