@model Vjezba.Model.Payment

<article class="detail-card">
    <div class="section-title">
        <h2>Uplata #@Model.Id</h2>
        <span class="badge-count">@Model.Amount</span>
    </div>
    <div class="field-list">
        <div class="field-row">
            <span class="field-label">Rezervacija</span>
            <span class="field-value">#@Model.Booking.Id — @Model.Booking.StartTime.ToString("dd.MM.yyyy HH:mm")</span>
        </div>
    </div>

    <form method="post" asp-action="Delete" asp-route-id="@Model.Id">
        <div class="form-actions">
            <button type="submit" class="btn btn-danger">Obriši</button>
            <a class="btn btn-outline" href="@Url.Action("Index", "Payments")">Otkaži</a>
        </div>
    </form>
</article>
