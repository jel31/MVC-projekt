@model Vjezba.Model.DogOwner

@{
    ViewData["Title"] = "Uređivanje vlasnika";
}

<section class="page-header" aria-labelledby="owner-edit-title">
    <div>
        <span class="eyebrow">CRUD vlasnici</span>
        <h1 id="owner-edit-title">Uredi vlasnika</h1>
        <p class="page-subtitle">Ažuriraj podatke za @Model.Name @Model.Surname.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline" href="@Url.Action("Details", "Owners", new { id = Model.Id })">Detalji</a>
        <a class="btn btn-outline" href="@Url.Action("Index", "Owners")">Natrag na popis</a>
    </div>
</section>

<section class="panel">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="form-section">
        <partial name="_OwnerForm" model="Model" />

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Spremi promjene</button>
            <a class="btn btn-outline" href="@Url.Action("Details", "Owners", new { id = Model.Id })">Odustani</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}