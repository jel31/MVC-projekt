@model IReadOnlyList<Vjezba.Model.DogOwner>

@{
    ViewData["Title"] = "Vlasnici";
}

@section Scripts {
    <script src="~/js/ajax-search.js" asp-append-version="true"></script>
    <script>
        (function () {
            var input = document.getElementById('owners-global-search');
            var results = document.getElementById('owners-search-results');
            if (!input || !results || !window.ajaxSearch) return;

            var endpoint = '/api/search/owners';
            window.ajaxSearch.attach({ input: input, endpoint: endpoint, container: results, pageSize: 12, debounceMs: 300, init: false, mainListSelector: '#owners-main-list' });
        })();
    </script>
}

<section class="page-header" aria-labelledby="owners-title">
    <div>
        <span class="eyebrow">Popis vlasnika</span>
        <h1 id="owners-title">Vlasnici pasa</h1>
        <p class="page-subtitle">Brzi pregled pasa i lokacija vlasnika.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" href="@Url.Action("Create", "Owners")">Dodaj vlasnika</a>
        <a class="btn btn-outline" href="@Url.Action("Index", "Dogs")">Pogledaj pse</a>
        <a class="btn btn-outline" href="@Url.Action("Index", "Home")">Natrag na početnu</a>
    </div>
</section>

<section class="search-section" aria-label="Traži vlasnike">
    <div id="owners-search-container" class="search-container">
        <label for="owners-global-search" class="sr-only">Pretraži vlasnike</label>
        <input id="owners-global-search" class="form-control" placeholder="Pretraži po imenu ili emailu..." />
    </div>
    <div id="owners-search-results" class="search-results" aria-live="polite"></div>
</section>

<div id="owners-main-list">
@if (!Model.Any())
{
    <section class="empty-state" aria-live="polite">
        <h2>Još nema vlasnika</h2>
        <p>Dodajte prvi profil vlasnika kako bi se ovdje pojavili njegovi psi i rezervacije.</p>
        <a class="btn btn-primary" href="@Url.Action("Create", "Owners")">Dodaj vlasnika</a>
    </section>
}


else
{
    <section class="entity-grid" aria-label="Popis vlasnika">
        @foreach (var owner in Model)
        {
            <article class="entity-card">
                <div class="entity-card__title">
                    <div>
                        <h2>@owner.Name @owner.Surname</h2>
                    </div>
                </div>

                <div class="entity-tags">
                    <span class="entity-tag">Psi: @(owner.Dogs.Any() ? string.Join(", ", owner.Dogs.Select(d => d.Name)) : "Nema pasa unesenih u profil.")</span>
                    <span class="entity-tag">Lokacija: @owner.Address</span>
                </div>

                <div class="entity-card__actions">
                    <a class="btn btn-primary" href="@Url.Action("Details", "Owners", new { id = owner.Id })">Detalji</a>
                    <a class="btn btn-outline" href="@Url.Action("Edit", "Owners", new { id = owner.Id })">Uredi</a>
                    <a class="btn btn-outline" href="@Url.Action("Delete", "Owners", new { id = owner.Id })">Obriši</a>
                </div>
            </article>
        }
    </section>
}
</div>